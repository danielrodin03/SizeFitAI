# SQLite database (created automatically in project root)
DATABASE_URL=sqlite+aiosqlite:///./sizefitai.db

# AI (Size Recommendation Engine)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# CORS: use * for any origin (extension + partners). Specific origins: https://a.com,https://b.com
CORS_ORIGINS=*

# Auto-create demo reviews + mock fallback when AI unavailable
DEMO_MODE=true
